<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:entry title="${%Notion Text}" field="notionText">
        <f:textarea />
    </f:entry>
    <f:entry title="${%Page Title}" field="pageTitle">
        <f:textbox />
    </f:entry>
    <f:entry title="${%Page Path}" field="pagePath">
        <f:textbox />
    </f:entry>
</j:jelly>
