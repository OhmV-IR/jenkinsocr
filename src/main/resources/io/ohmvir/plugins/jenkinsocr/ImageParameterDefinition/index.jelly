<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:f="/lib/form">
    <st:adjunct includes="io.ohmvir.plugins.jenkinsocr.ImageParameterDefinition.preview" />
    <f:entry title="${it.name}" description="${it.description}">
        <div name="parameter" class="jenkins-file-parameter">
            <input type="hidden" name="name" value="${it.name}" />
            <input type="file" name="${it.name}" accept="image/*" capture="environment" class="jenkins-input jenkinsocr-image-input" />
            <div style="margin-top: 10px;">
                <img src=""
                     alt="Image Preview"
                     class="jenkinsocr-image-preview"
                     style="max-width: 250px; max-height: 250px; display: none; border: 1px solid var(--border-color); border-radius: 6px;" />
            </div>
        </div>
    </f:entry>
</j:jelly>
