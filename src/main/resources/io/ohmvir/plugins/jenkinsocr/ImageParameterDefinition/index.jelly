<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:entry title="${it.name}" description="${it.description}">
        <div name="parameter" class="jenkins-file-parameter">
            <input type="hidden" name="name" value="${it.name}" />
            <!-- .heic/.heif are listed explicitly because some desktop file pickers leave them out of image/* -->
            <input type="file" name="${it.name}" accept="image/*,.heic,.heif" capture="environment"
                   class="jenkins-input" data-jenkinsocr-image-input="true" />
            <div class="jenkinsocr-image-status" style="margin-top: 10px;" hidden="hidden" />
            <div style="margin-top: 10px;">
                <img class="jenkinsocr-image-preview"
                     src=""
                     alt="Image Preview"
                     style="max-width: 250px; max-height: 250px; display: none; border: 1px solid var(--border-color); border-radius: 6px;" />
            </div>
            <!-- Converts HEIC photos to JPEG before upload and shows the preview -->
            <script type="module" src="${resURL}/plugin/jenkinsocr/js/image-parameter.js" />
        </div>
    </f:entry>
</j:jelly>
