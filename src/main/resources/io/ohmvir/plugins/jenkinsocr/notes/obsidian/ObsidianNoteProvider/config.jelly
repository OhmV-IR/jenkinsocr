<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:entry title="${%Vault Folder}" field="vaultPath">
        <f:textbox />
    </f:entry>
    <f:entry title="${%Node}" field="nodeName">
        <f:select />
    </f:entry>
    <f:advanced>
        <f:entry title="${%Maximum Folder Depth}" field="maxFolderDepth">
            <f:number default="10" min="1" />
        </f:entry>
    </f:advanced>
</j:jelly>
