<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:c="/lib/credentials">
    <f:entry title="${%Notion Integration Token}" field="credentialsId">
        <c:select />
    </f:entry>
    <f:entry title="${%Root Page}" field="rootPageId">
        <f:textbox />
    </f:entry>
    <f:advanced>
        <f:entry title="${%Maximum Folder Depth}" field="maxFolderDepth">
            <f:number default="10" min="1" />
        </f:entry>
    </f:advanced>
</j:jelly>
