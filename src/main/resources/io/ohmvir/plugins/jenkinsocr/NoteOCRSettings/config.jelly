<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:c="/lib/credentials">
    <f:section title="${%Note OCR Settings}">
        <f:entry title="${%Model ID}" field="modelId">
            <f:select />
        </f:entry>
        <f:entry title="${%Formula Output Type}" field="formulaOutputType">
            <f:enum>${it}</f:enum>
        </f:entry>
        <f:entry title="${%Temperature}" field="temperature">
            <f:textbox default="0.1" />
        </f:entry>
        <f:entry title="${%Max Image Dimension}" field="maxImageDimension"
                 description="${%Photos are scaled down so their longest edge is at most this many pixels before being sent to the model. Default: 1568.}">
            <f:number min="1" max="8000" default="1568" />
        </f:entry>
        <f:entry title="${%Notion API Token Credential}" field="notionApiTokenCredentialId">
            <c:select />
        </f:entry>
        <f:entry title="${%Root Page ID}" field="rootPageId">
            <f:textbox />
        </f:entry>
    </f:section>
</j:jelly>