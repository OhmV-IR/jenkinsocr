<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:section title="${%Note OCR Settings}">
        <f:entry title="${%Model ID}" field="modelId">
            <f:select />
        </f:entry>
        <f:entry title="${%Formula Output Type}" field="formulaOutputType">
            <f:enum>${it}</f:enum>
        </f:entry>
        <f:entry title="${%Temperature}" field="temperature">
            <f:textbox default="0.1" />
        </f:entry>
        <f:dropdownDescriptorSelector field="noteProvider" title="${%Note Provider}" descriptors="${descriptor.noteProviderDescriptors}" />
    </f:section>
</j:jelly>
